generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int            @id @default(autoincrement())
  name        String
  price       Float
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  description String?        @db.Text
  manualCost  Decimal?       @db.Decimal(10, 2)
  extraCost   Decimal?       @db.Decimal(10, 2)
  recipeId    Int?
  saleAmount  Decimal        @db.Decimal(10, 2)
  saleUnit    String?
  slug        String         @unique
  stock       Int            @default(0)
  updatedAt   DateTime       @default(now()) @updatedAt
  orderItems  OrderItem[]
  recipe      Recipe?        @relation(fields: [recipeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Product_recipeId_fk")
  images      ProductImage[]

  @@index([recipeId], map: "Product_recipeId_fk")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  position  Int      @default(0)
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId], map: "ProductImage_productId_fkey")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal @default(0.00) @db.Decimal(10, 2)
  order     Orders  @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([productId], map: "OrderItem_productId_fkey")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  lastname  String?
  email     String   @unique(map: "email")
  createdAt DateTime @default(now())
  password  String   @default("")
  role      Role     @default(USER)
  phone     String?
  address   String?
  Orders    Orders[]
}

model Orders {
  id               Int           @id @default(autoincrement())
  customerName     String
  customerLastname String
  phone            String
  status           Orders_status
  createdAt        DateTime      @default(now())
  email            String        @default("")
  address          String        @default("")
  userId           String?
  subtotal         Decimal?      @db.Decimal(10, 2)
  total            Decimal?      @db.Decimal(10, 2)
  deliveryFee      Decimal?      @db.Decimal(10, 2)
  discount         Decimal?      @db.Decimal(10, 2)
  note             String?       @db.Text
  orderItems       OrderItem[]
  User             User?         @relation(fields: [userId], references: [id], map: "Order_userId_fkey")

  @@index([userId], map: "Order_userId_fkey")
}

model Ingredient {
  id           Int                      @id @default(autoincrement())
  name         String
  unit         String
  price        Decimal                  @db.Decimal(10, 2)
  stock        Decimal?                 @db.Decimal(10, 2)
  updatedAt    DateTime                 @default(now()) @updatedAt @db.DateTime(0)
  priceHistory IngredientPriceHistory[]
  recipeItems  RecipeItem[]
}

model Recipe {
  id        Int          @id @default(autoincrement())
  name      String
  yield     Decimal      @db.Decimal(10, 2)
  yieldUnit String
  createdAt DateTime?    @default(now()) @db.DateTime(0)
  updatedAt DateTime?    @default(now()) @updatedAt @db.DateTime(0)
  products  Product[]
  items     RecipeItem[]
}

model RecipeItem {
  id           Int        @id @default(autoincrement())
  ingredientId Int
  quantity     Decimal    @db.Decimal(10, 2)
  unit         String
  recipeId     Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "RecipeItem_ibfk_2")
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "RecipeItem_recipeId_fk")

  @@index([ingredientId], map: "ingredientId")
  @@index([recipeId], map: "RecipeItem_recipeId_fk")
}

model IngredientPriceHistory {
  id           Int        @id @default(autoincrement())
  ingredientId Int
  price        Decimal    @db.Decimal(10, 2)
  createdAt    DateTime   @default(now()) @db.DateTime(0)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "IngredientPriceHistory_ibfk_1")

  @@index([ingredientId], map: "ingredientId")
}

model StoreSettings {
  id                    Int      @id @default(1)
  deliveryFee           Decimal  @db.Decimal(10, 2)
  freeDeliveryFrom      Decimal? @db.Decimal(10, 2)
  minimumOrderAmount    Decimal? @db.Decimal(10, 2)
  storeOpen             Boolean  @default(true)
  openingTime           String?  @db.VarChar(10)
  closingTime           String?  @db.VarChar(10)
  whatsappPhone         String?  @db.VarChar(30)
  storeEmail            String?  @db.VarChar(255)
  instagramUrl          String?  @db.VarChar(255)
  allowGuestCheckout    Boolean  @default(true)
  enableCoupons         Boolean  @default(true)
  maxDiscountPercentage Int?
  announcementBar       String?  @db.Text
  maintenanceMode       Boolean  @default(false)
  updatedAt             DateTime @default(now()) @updatedAt @db.DateTime(0)
}

model Coupon {
  id         Int       @id @default(autoincrement())
  code       String    @unique(map: "code") @db.VarChar(100)
  percentage Int
  active     Boolean   @default(true)
  expiresAt  DateTime? @db.DateTime(0)
  maxUses    Int?
  usedCount  Int       @default(0)
}

enum Role {
  USER
  ADMIN
}

enum Orders_status {
  PENDING
  PREPARING
  READY
  CANCELLED
  SHIPPED
  PICKEDUP
}
