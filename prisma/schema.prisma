generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── TENANCY ────────────────────────────────────────────────

model Organization {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  plan          String         @default("free")
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  products      Product[]
  orders        Order[]
  customers     Customer[]
  recipes       Recipe[]
  ingredients   Ingredient[]
  coupons       Coupon[]
  storeSettings StoreSettings?
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String
  memberships Membership[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(STAFF)
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  name           String?
  lastname       String?
  email          String
  createdAt      DateTime     @default(now())
  phone          String?
  address        String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  orders         Order[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

// ─── CATÁLOGO ───────────────────────────────────────────────

model Product {
  id             Int            @id @default(autoincrement())
  organizationId String
  name           String
  price          Float
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  description    String?        @db.Text
  manualCost     Decimal?       @db.Decimal(10, 2)
  extraCost      Decimal?       @db.Decimal(10, 2)
  recipeId       Int?
  saleAmount     Decimal        @db.Decimal(10, 2)
  saleUnit       String?
  slug           String
  stock          Int            @default(0)
  updatedAt      DateTime       @default(now()) @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
  orderItems     OrderItem[]
  recipe         Recipe?        @relation(fields: [recipeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Product_recipeId_fk")
  images         ProductImage[]

  @@unique([organizationId, slug])
  @@index([recipeId], map: "Product_recipeId_fk")
  @@index([organizationId])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  position  Int      @default(0)
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId], map: "ProductImage_productId_fkey")
}

// ─── PEDIDOS ────────────────────────────────────────────────

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal @default(0.00) @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([productId], map: "OrderItem_productId_fkey")
}

model Order {
  id               Int           @id @default(autoincrement())
  organizationId   String
  customerName     String
  customerLastname String
  phone            String
  status           Orders_status
  createdAt        DateTime      @default(now())
  email            String        @default("")
  address          String        @default("")
  customerId       String?
  subtotal         Decimal?      @db.Decimal(10, 2)
  total            Decimal?      @db.Decimal(10, 2)
  deliveryFee      Decimal?      @db.Decimal(10, 2)
  discount         Decimal?      @db.Decimal(10, 2)
  note             String?       @db.Text
  organization     Organization  @relation(fields: [organizationId], references: [id])
  customer         Customer?     @relation(fields: [customerId], references: [id], map: "Order_customerId_fkey")
  orderItems       OrderItem[]

  @@index([customerId], map: "Order_customerId_fkey")
  @@index([organizationId])
}

// ─── RECETAS E INSUMOS ──────────────────────────────────────

model Ingredient {
  id             Int                      @id @default(autoincrement())
  organizationId String
  name           String
  unit           String
  price          Decimal                  @db.Decimal(10, 2)
  stock          Decimal?                 @db.Decimal(10, 2)
  updatedAt      DateTime                 @default(now()) @updatedAt @db.DateTime(0)
  organization   Organization             @relation(fields: [organizationId], references: [id])
  priceHistory   IngredientPriceHistory[]
  recipeItems    RecipeItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Recipe {
  id             Int          @id @default(autoincrement())
  organizationId String
  name           String
  yield          Decimal      @db.Decimal(10, 2)
  yieldUnit      String
  createdAt      DateTime?    @default(now()) @db.DateTime(0)
  updatedAt      DateTime?    @default(now()) @updatedAt @db.DateTime(0)
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]
  items          RecipeItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RecipeItem {
  id           Int        @id @default(autoincrement())
  ingredientId Int
  quantity     Decimal    @db.Decimal(10, 2)
  unit         String
  recipeId     Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "RecipeItem_ibfk_2")
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "RecipeItem_recipeId_fk")

  @@unique([recipeId, ingredientId])
  @@index([ingredientId], map: "ingredientId")
  @@index([recipeId], map: "RecipeItem_recipeId_fk")
}

model IngredientPriceHistory {
  id           Int        @id @default(autoincrement())
  ingredientId Int
  price        Decimal    @db.Decimal(10, 2)
  createdAt    DateTime   @default(now()) @db.DateTime(0)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "IngredientPriceHistory_ibfk_1")

  @@index([ingredientId], map: "ingredientId")
}

// ─── CONFIGURACIÓN DE TIENDA ────────────────────────────────

model StoreSettings {
  organizationId        String       @id
  organization          Organization @relation(fields: [organizationId], references: [id])
  deliveryFee           Decimal      @db.Decimal(10, 2)
  freeDeliveryFrom      Decimal?     @db.Decimal(10, 2)
  minimumOrderAmount    Decimal?     @db.Decimal(10, 2)
  storeOpen             Boolean      @default(true)
  openingTime           String?      @db.VarChar(10)
  closingTime           String?      @db.VarChar(10)
  whatsappPhone         String?      @db.VarChar(30)
  storeEmail            String?      @db.VarChar(255)
  instagramUrl          String?      @db.VarChar(255)
  allowGuestCheckout    Boolean      @default(true)
  enableCoupons         Boolean      @default(true)
  maxDiscountPercentage Int?
  announcementBar       String?      @db.Text
  maintenanceMode       Boolean      @default(false)
  updatedAt             DateTime     @default(now()) @updatedAt @db.DateTime(0)
}

model Coupon {
  id             Int          @id @default(autoincrement())
  organizationId String
  code           String
  percentage     Int
  active         Boolean      @default(true)
  expiresAt      DateTime?    @db.DateTime(0)
  maxUses        Int?
  usedCount      Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
}

// ─── ENUMS ──────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum Orders_status {
  PENDING
  PREPARING
  READY
  CANCELLED
  SHIPPED
  PICKEDUP
}
