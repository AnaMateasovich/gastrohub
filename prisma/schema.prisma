generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?   @db.Text
  price       Decimal   @db.Decimal(10,2)
  images      ProductImage[]
  stock       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orderItems  OrderItem[]
  recipeItems RecipeItem[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  position  Int      @default(0)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price Decimal @default(0) @db.Decimal(10, 2)
  order     Orders  @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([productId], map: "OrderItem_productId_fkey")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique(map: "email")
  createdAt DateTime @default(now())
  password  String   @default("")
  role      Role     @default(USER)
  phone     String?
  address   String?
  Orders    Orders[]
}

model Orders {
  id           Int           @id @default(autoincrement())
  customerName String
  phone        String
  status       Orders_status @default(PENDING)
  createdAt    DateTime      @default(now())
  email        String        @default("")
  address      String        @default("")
  userId       String?
  subtotal     Decimal?      @db.Decimal(10, 2)
  total        Decimal?      @db.Decimal(10, 2)
  deliveryFee  Decimal?      @db.Decimal(10, 2)
  discount     Decimal?      @db.Decimal(10, 2)
  note         String?       @db.Text
  orderItems   OrderItem[]
  User         User?         @relation(fields: [userId], references: [id], map: "Order_userId_fkey")

  @@index([userId], map: "Order_userId_fkey")
}

model Ingredient {
  id           Int                      @id @default(autoincrement())
  name         String
  unit         String
  price        Decimal                  @db.Decimal(10, 2)
  stock        Decimal?                 @db.Decimal(10, 2)
  updatedAt    DateTime                 @default(now()) @updatedAt @db.DateTime(0)
  priceHistory IngredientPriceHistory[]
  recipeItems  RecipeItem[]
}

model RecipeItem {
  id           Int        @id @default(autoincrement())
  productId    Int
  ingredientId Int
  quantity     Decimal    @db.Decimal(10, 2)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "RecipeItem_ibfk_1")
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "RecipeItem_ibfk_2")

  @@index([ingredientId], map: "ingredientId")
  @@index([productId], map: "RecipeItem_ibfk_1")
}

model IngredientPriceHistory {
  id           Int        @id @default(autoincrement())
  ingredientId Int
  price        Decimal    @db.Decimal(10, 2)
  createdAt    DateTime   @default(now()) @db.DateTime(0)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "IngredientPriceHistory_ibfk_1")

  @@index([ingredientId], map: "ingredientId")
}

model StoreSettings {
  id Int @id @default(1)

  // Delivery
  deliveryFee        Decimal  @db.Decimal(10, 2)
  freeDeliveryFrom   Decimal? @db.Decimal(10, 2)
  minimumOrderAmount Decimal? @db.Decimal(10, 2)

  // Negocio
  storeOpen   Boolean @default(true)
  openingTime String?
  closingTime String?

  // Contacto
  whatsappPhone String?
  storeEmail    String?
  instagramUrl  String?

  // Checkout
  allowGuestCheckout Boolean @default(true)

  // Promos
  enableCoupons         Boolean @default(true)
  maxDiscountPercentage Int?

  // UI
  announcementBar String?
  maintenanceMode Boolean @default(false)

  updatedAt DateTime @updatedAt
}

model Coupon {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  percentage Int
  active     Boolean   @default(true)
  expiresAt  DateTime?
  maxUses    Int?
  usedCount  Int       @default(0)
}

enum Role {
  USER
  ADMIN
}

enum Orders_status {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
  SHIPPED
  PICKEDUP
}
